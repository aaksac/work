<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Yapay Zeka Çalıştayı 2025</title>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --primary-color: #4e5bf5;
      --accent-color: #c62828;
      --bg-dark: #121212;
      --text-light: #f5f5f5;
      --text-dark: #333333;
      --font-family: 'Poppins', sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-family);
      line-height: 1.6;
      color: var(--text-dark);
    }
    a { text-decoration: none; color: inherit; }
    /* NAVBAR */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      background: #fff;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .navbar .logo {
      font-weight: 800;
      font-size: 1.2rem;
      color: var(--primary-color);
    }
    .navbar .nav-links {
      list-style: none;
      display: flex;
      gap: 1.5rem;
    }
    .navbar .nav-links a {
      font-weight: 600;
      transition: color 0.3s;
    }
    .navbar .nav-links a:hover { color: var(--primary-color); }
    /* HERO */
    .hero {
      height: 100vh;
      background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      color: #fff;
      padding: 0 1rem;
    }
    .hero h1 {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
    }
    .hero p {
      font-size: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .hero .btn {
      background: #fff;
      color: var(--bg-dark);
      padding: 0.75rem 2rem;
      border-radius: 50px;
      font-weight: 600;
      transition: opacity 0.3s;
    }
    .hero .btn:hover { opacity: 0.9; }
    /* GENEL BÖLÜM STİLLERİ */
    section {
      padding: 4rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    section h2 {
      text-align: center;
      font-size: 2rem;
      margin-bottom: 2rem;
      color: var(--primary-color);
    }
    section p {
      max-width: 800px;
      margin: 0 auto;
      font-size: 1.1rem;
      text-align: justify;
    }
    /* PROGRAM */
    .timeline {
      display: flex;
      flex-wrap: wrap;
      gap: 2%;
      justify-content: space-between;
    }
    .timeline-item {
      width: 48%;
      background: #fff;
      padding: 1.5rem;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      margin-bottom: 2rem;
    }
    .timeline-item h3 { margin-bottom: 0.5rem; color: var(--accent-color); }
    /* KONUŞMACILAR */
    .cards {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      justify-content: center;
    }
    .card {
      width: 250px;
      background: #fff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      text-align: center;
    }
    .card img { width: 100%; display: block; }
    .card h4 { margin: 1rem 0 0.5rem; }
    .card small {
      color: #555;
      display: block;
      margin-bottom: 1rem;
    }
    /* KAYIT FORMU */
    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 500px;
      margin: 0 auto;
    }
    form input, form select, form button {
      padding: 0.75rem 1rem;
      font-size: 1rem;
      border: 1px solid #ccc;
      border-radius: 4px;
    }
    form button {
      background: var(--primary-color);
      color: #fff;
      border: none;
      cursor: pointer;
      font-weight: 600;
      transition: background 0.3s;
    }
    form button:hover { background: #3b47c4; }
    /* İLETİŞİM */
    #contact p {
      text-align: center;
      font-size: 1.1rem;
    }
    /* FOOTER */
    footer {
      background: #222;
      color: #aaa;
      text-align: center;
      padding: 2rem 1rem;
      font-size: 0.9rem;
    }
    /* RESPONSIVE */
    @media (max-width: 768px) {
      .timeline-item, .card { width: 100%; }
      .navbar .nav-links { display: none; }
    }
  </style>
</head>
<body>

  <!-- ÜSTBARA -->
  <header>
    <nav class="navbar">
      <div class="logo">YZ Çalıştayı</div>
      <ul class="nav-links">
        <li><a href="#about">Hakkında</a></li>
        <li><a href="#program">Program</a></li>
        <li><a href="#speakers">Konuşmacılar</a></li>
        <li><a href="#register">Kayıt</a></li>
        <li><a href="#contact">İletişim</a></li>
      </ul>
    </nav>
    <!-- HERO BÖLÜMÜ -->
    <div class="hero">
      <h1>Yapay Zeka Çalıştayı 2025</h1>
      <p>Yeni nesil algoritmalar, uygulamalar ve toplumsal etkileri keşfetmeye davetlisiniz.</p>
      <a href="#register" class="btn">Hemen Kayıt Ol</a>
    </div>
  </header>

  <!-- HAKKINDA -->
  <section id="about">
    <h2>Hakkında</h2>
    <p>
      17–18 Mayıs 2025 tarihlerinde düzenlenecek olan “Yapay Zeka Çalıştayı”, akademi ve
      endüstriden uzmanları bir araya getirerek son gelişmeleri,
      uygulama örneklerini ve etik-meydana getirdiği tartışmaları ele alacaktır.
    </p>
  </section>

  <!-- PROGRAM -->
  <section id="program">
    <h2>Program</h2>
    <div class="timeline">
      <div class="timeline-item">
        <h3>17 Mayıs 09:30</h3>
        <p>Açılış Konuşmaları ve Tanışma</p>
      </div>
      <div class="timeline-item">
        <h3>17 Mayıs 10:00</h3>
        <p>Makine Öğrenmesi Temelleri</p>
      </div>
      <div class="timeline-item">
        <h3>17 Mayıs 14:00</h3>
        <p>Derin Öğrenme Uygulamaları</p>
      </div>
      <div class="timeline-item">
        <h3>18 Mayıs 09:30</h3>
        <p>AI Etiği ve Toplumsal Etkiler</p>
      </div>
      <div class="timeline-item">
        <h3>18 Mayıs 13:00</h3>
        <p>Çalıştay Değerlendirmesi ve Kapanış</p>
      </div>
    </div>
  </section>

  <!-- KONUŞMACILAR -->
  <section id="speakers">
    <h2>Konuşmacılar</h2>
    <div class="cards">
      <div class="card">
        <img src="speaker1.jpg" alt="Dr. Ayşe Yılmaz" />
        <h4>Dr. Ayşe Yılmaz</h4>
        <small>Makine Öğrenmesi Uzmanı</small>
      </div>
      <div class="card">
        <img src="speaker2.jpg" alt="Prof. Mehmet Kara" />
        <h4>Prof. Mehmet Kara</h4>
        <small>Derin Öğrenme Araştırmacısı</small>
      </div>
    </div>
  </section>

  <!-- KAYIT FORMU -->
  <section id="register">
    <h2>Kayıt</h2>
    <form action="#" method="POST">
      <input type="text" name="name" placeholder="Adınız Soyadınız" required />
      <input type="email" name="email" placeholder="E-posta Adresiniz" required />
      <select name="ticket" required>
        <option value="" disabled selected>Bilet Tipi Seçin</option>
        <option value="standard">Standart</option>
        <option value="student">Öğrenci</option>
        <option value="vip">VIP</option>
      </select>
      <button type="submit">Kayıt Ol</button>
    </form>
  </section>

  <!-- İLETİŞİM -->
  <section id="contact">
    <h2>İletişim</h2>
    <p>Her türlü soru ve öneri için: <a href="mailto:info@yzcalistayi.com">info@yzcalistayi.com</a></p>
  </section>

  <!-- ALT BİLGİLER -->
  <footer>
    &copy; 2025 Yapay Zeka Çalıştayı &middot; Tüm Hakları Saklıdır.
  </footer>

</body>
</html>
